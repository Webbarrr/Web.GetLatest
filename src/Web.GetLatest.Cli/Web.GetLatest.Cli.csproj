<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Package metadata for dotnet global tool packaging -->
  <PropertyGroup>
    <!-- When publishing, CI should set PackageVersion via /p:PackageVersion or use Git tag -->
    <PackageId>ghver</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ghver</ToolCommandName>
    <Authors>Webbarrr</Authors>
    <Description>ghver — fetch the latest GitHub release information from the command line.</Description>
    <PackageTags>github;releases;cli;ghver</PackageTags>
    <PackageProjectUrl>https://github.com/Webbarrr/Web.GetLatest</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Webbarrr/Web.GetLatest</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Include symbols in package if desired -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
	<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
	<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Web.GetLatest.Infrastructure\Web.GetLatest.Infrastructure.csproj" />
  </ItemGroup>

</Project>
